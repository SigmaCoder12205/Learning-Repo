# Maintainer: Archer Dragone
# Installs the static release binary from GitHub; bench-git builds from source instead.
pkgname=bench-bin
pkgver=0.15.0
pkgrel=1
pkgdesc="Benchmark native executables and Python scripts with isolated C process measurement (static binary)"
arch=('x86_64')
url="https://github.com/SigmaCoder12205/Learning-Repo/tree/main/testing"
license=('MIT')
optdepends=('python: benchmark Python scripts'
            'python-pandas: bench analyze and parquet export'
            'python-numpy: bench analyze'
            'python-matplotlib: bench analyze --plot'
            'python-pyarrow: parquet export'
            'perf: --perf and --hotspots'
            'valgrind: --valgrind'
            'heaptrack: --heaptrack'
            'strace: socket tracing for --networking'
            'intel-gpu-tools: --gpu')
provides=("bench=$pkgver" 'cppbench')
conflicts=('bench' 'bench-git')
options=('!strip' '!debug')
_archive="bench-$pkgver-x86_64-unknown-linux-musl"
source=("https://github.com/SigmaCoder12205/Learning-Repo/releases/download/bench-v$pkgver/$_archive.tar.gz")
sha256sums=('5fea42c50f5106ef61e434a9858621d8a3831781cba7632b59eb73bdf90ca06d')

package() {
  cd "$_archive"
  install -Dm755 bin/bench "$pkgdir/usr/bin/bench"
  ln -s bench "$pkgdir/usr/bin/cppbench"
  install -Dm644 -t "$pkgdir/usr/include" include/*.h
  install -Dm644 -t "$pkgdir/usr/share/doc/bench" share/doc/bench/*
  install -Dm644 share/licenses/bench/LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
