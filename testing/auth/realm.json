{
  "realm": "cppbench",
  "displayName": "cppbench",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": true,
  "registrationEmailAsUsername": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": true,
  "bruteForceProtected": true,
  "passwordPolicy": "length(12)",
  "accessTokenLifespan": 300,
  "offlineSessionMaxLifespanEnabled": false,
  "offlineSessionIdleTimeout": 315360000,
  "revokeRefreshToken": false,
  "roles": {
    "realm": [
      {
        "name": "default-roles-cppbench",
        "composite": true,
        "composites": {
          "realm": [
            "offline_access",
            "uma_authorization"
          ],
          "client": {
            "account": [
              "view-profile",
              "manage-account",
              "delete-account"
            ]
          }
        }
      },
      {
        "name": "offline_access"
      },
      {
        "name": "uma_authorization"
      }
    ]
  },
  "defaultRole": {
    "name": "default-roles-cppbench"
  },
  "requiredActions": [
    {
      "alias": "TERMS_AND_CONDITIONS",
      "name": "Terms and Conditions",
      "providerId": "TERMS_AND_CONDITIONS",
      "enabled": false,
      "defaultAction": false,
      "priority": 20,
      "config": {}
    },
    {
      "alias": "UPDATE_PROFILE",
      "name": "Update Profile",
      "providerId": "UPDATE_PROFILE",
      "enabled": true,
      "defaultAction": false,
      "priority": 40,
      "config": {}
    },
    {
